# Copy this file to `.env.local` for local development.
# Never commit `.env.local` — it may contain the Sitecore API key.

# Sitecore Experience Edge / Content GraphQL endpoint
SITECORE_GRAPHQL_ENDPOINT=https://edge.sitecorecloud.io/api/graphql/v1

# Server-only API key. Do not prefix with NEXT_PUBLIC_.
SITECORE_API_KEY=

# XM Cloud site name (LCMC site collection / site)
SITECORE_SITE_NAME=lcmc

# When true (default for this kiosk demo), API functions return fixtures from
# lib/sitecore/mock instead of calling Sitecore. Set to false once credentials
# are wired and you want live GraphQL.
USE_MOCK_DATA=true
